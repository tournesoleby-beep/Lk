// Prisma schema for the e-commerce platform.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Supabase: use the pooled connection (PgBouncer, port 6543) for DATABASE_URL
  // and the direct connection (port 5432) for DIRECT_URL, used only for migrations.
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) models — Prisma adapter schema
// https://authjs.dev/getting-started/adapters/prisma
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  password      String? // hashed password, only set for credentials sign-in
  role          UserRole  @default(CUSTOMER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  accounts Account[]
  sessions Session[]
  addresses Address[]
  cart      Cart?
  orders    Order[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  imageUrl    String?  @map("image_url")

  parentId String?    @map("parent_id")
  parent   Category?  @relation("CategoryToSubcategory", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryToSubcategory")

  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?       @db.Text
  price       Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?   @db.Decimal(10, 2) @map("compare_at_price")
  currency    String        @default("IDR")
  sku         String?       @unique
  status      ProductStatus @default(DRAFT)
  featured    Boolean       @default(false)
  // Used for Biteship shipping-rate calculation (see
  // src/lib/checkout/actions.ts and src/lib/checkout/shipping.ts). Defaults
  // to 500g for newly created products. Existing rows that were still at
  // the old 0g default are backfilled to the same 500g value by running
  // scripts/backfill-product-weight.sql once against the database (this
  // project uses `prisma db push`, not migrations, so there's no migration
  // to carry that data change).
  weightGrams Int           @default(500) @map("weight_grams")

  categoryId String?   @map("category_id")
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  images     ProductImage[]
  variants   ProductVariant[]
  productReviews ProductReview[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  stockHistory StockHistory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  url       String
  altText   String? @map("alt_text")
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String  @map("product_id")
  name      String // e.g. "Size / Color"
  sku       String? @unique
  price     Decimal? @db.Decimal(10, 2)
  stock     Int      @default(0)
  options   Json // e.g. { "size": "M", "color": "Black" }

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_variants")
}

enum StockChangeReason {
  INITIAL_STOCK // set when a product (or its first variant) is created
  RESTOCK // admin edit that increases stock
  MANUAL_ADJUSTMENT // admin edit that decreases stock (correction, damage, etc.)
  ORDER_PAID // automatic deduction when an order is marked PAID
}

// A running ledger of every stock change for a product — see
// src/lib/admin/stock-history.ts for the write helper used by product
// create/update (src/lib/admin/actions.ts) and the order-paid deduction
// (src/lib/admin/order-actions.ts), and getProductStockHistory for the read
// side that powers the admin product edit modal's Stock History section.
model StockHistory {
  id             String            @id @default(cuid())
  productId      String            @map("product_id")
  quantityChange Int               @map("quantity_change") // signed: positive = stock in, negative = stock out
  previousStock  Int               @map("previous_stock")
  newStock       Int               @map("new_stock")
  reason         StockChangeReason

  // Set only for ORDER_PAID entries, so the admin ledger can link back to
  // the order that caused the deduction.
  orderId String? @map("order_id")
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([orderId])
  @@map("stock_history")
}

// Verified product reviews tied to a fulfilled order line, rather than a
// User account (this project has no customer-account requirement for
// reviewing — see Order/OrderItem, which already snapshot everything
// needed at purchase time). reviewerName is likewise a snapshot taken from
// the order (e.g. shippingAddress.fullName), not a User relation.
//
// Eligibility (only DELIVERED orders may be reviewed) is business logic to
// be enforced where reviews are created, not expressed here in the schema.
model ProductReview {
  id           String  @id @default(cuid())
  productId    String  @map("product_id")
  orderId      String  @map("order_id")
  rating       Int // 1-5
  comment      String? @db.Text
  images       Json? // optional array of Cloudinary image URLs
  reviewerName String  @map("reviewer_name") // snapshot from the order, not a User relation
  approved     Boolean @default(false)
  featured     Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // One review per product per order.
  @@unique([productId, orderId])
  @@index([productId])
  @@index([orderId])
  @@map("product_reviews")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model Cart {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String  @map("cart_id")
  productId String  @map("product_id")
  variantId String? @map("variant_id")
  quantity  Int     @default(1)

  cart    Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  WAITING_VERIFICATION // manual bank-transfer proof uploaded, awaiting admin review
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  PAYMENT_REJECTED // admin reviewed the transfer proof and rejected it
}

enum AddressType {
  SHIPPING
  BILLING
}

model Address {
  id         String      @id @default(cuid())
  userId     String      @map("user_id")
  type       AddressType @default(SHIPPING)
  fullName   String      @map("full_name")
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String      @map("postal_code")
  country    String
  phone      String?
  isDefault  Boolean     @default(false) @map("is_default")

  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingOrders Order[] @relation("ShippingAddress")
  billingOrders  Order[] @relation("BillingAddress")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("addresses")
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique @map("order_number")
  userId        String      @map("user_id")
  status        OrderStatus @default(PENDING)

  subtotal      Decimal @db.Decimal(10, 2)
  shippingTotal Decimal @default(0) @db.Decimal(10, 2) @map("shipping_total")
  taxTotal      Decimal @default(0) @db.Decimal(10, 2) @map("tax_total")
  total         Decimal @db.Decimal(10, 2)
  currency      String  @default("IDR")

  shippingAddressId String?  @map("shipping_address_id")
  billingAddressId  String?  @map("billing_address_id")
  shippingAddress   Address? @relation("ShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress    Address? @relation("BillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)

  stripePaymentIntentId String? @map("stripe_payment_intent_id")

  // Shipping fields — populated at checkout (shippingMethod, weight
  // snapshot) or left for a future carrier integration to fill in
  // (carrier/tracking/estimated delivery). No shipping API is called yet;
  // these only store data so that integration can be added later without
  // another schema change.
  shippingMethod         String?   @map("shipping_method") // e.g. "standard" | "express", chosen at checkout
  shippingWeightGrams    Int?      @map("shipping_weight_grams") // snapshot of total order weight at checkout time
  shippingCarrier        String?   @map("shipping_carrier") // human-readable courier label, e.g. "JNE" — set later by the carrier integration
  biteshipCourierCode    String?   @map("biteship_courier_code") // Biteship's courier code for the same courier, e.g. "jne" — used to query live tracking (see src/lib/biteship.ts); kept separate from shippingCarrier so that field can stay a display label
  trackingNumber         String?   @map("tracking_number") // set later by the carrier integration
  estimatedDeliveryDate  DateTime? @map("estimated_delivery_date") // set later by the carrier integration

  // Manual bank-transfer payment proof, uploaded by the customer on the
  // /checkout/payment page and hosted on Cloudinary (see src/lib/cloudinary.ts).
  // No separate "payment" table — this is the only data the flow needs, so
  // it lives directly on Order to keep the schema change minimal.
  paymentProofUrl        String?   @map("payment_proof_url")
  paymentProofUploadedAt DateTime? @map("payment_proof_uploaded_at")

  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]
  stockHistory StockHistory[]
  productReviews ProductReview[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String  @map("order_id")
  // Nullable: `name`/`price` below already snapshot everything needed to
  // render order history, so the live product link can be cleared rather
  // than blocking deletion — see onDelete below and
  // src/lib/admin/actions.ts (deleteProduct) for the business-logic side
  // of this (only *active* orders should block deleting a product).
  productId String? @map("product_id")
  variantId String? @map("variant_id")

  name     String // snapshot of product name at purchase time
  price    Decimal @db.Decimal(10, 2) // snapshot of unit price at purchase time
  quantity Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}
